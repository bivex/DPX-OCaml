              "id": "DPX-OCAML-FUNCTOR_PARAMETRIC_MODULE",
              "name": "functor_parametric_module",
              "shortDescription": {
                "text": "OCaml Pattern: Functor Parametric Module"
              },
              "fullDescription": {
                "text": "Module 'Two_tier_jit_usecase' implements Functor Parametric Module pattern enabling compile-time type parameterization and dependency injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-ABSTRACT_DATA_TYPE_INTERFACE",
              "name": "abstract_data_type_interface",
              "shortDescription": {
                "text": "OCaml Pattern: Abstract Data Type Interface"
              },
              "fullDescription": {
                "text": "Module 'Vectis_state_masking' encapsulates Abstract Data Type (ADT) via primary type `t` with constructor 'create'"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-MODULE_INCLUSION_EXTENDER",
              "name": "module_inclusion_extender",
              "shortDescription": {
                "text": "OCaml Pattern: Module Inclusion Extender"
              },
              "fullDescription": {
                "text": "Module 'System_entropy_adapter' extends and composes functionality from 1 included module(s) (Entropy_port.S)"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-POLYMORPHIC_VARIANTS",
              "name": "polymorphic_variants",
              "shortDescription": {
                "text": "OCaml Pattern: Polymorphic Variants"
              },
              "fullDescription": {
                "text": "Module 'C_visa_c_handlers' adopts Polymorphic Variants (``ZeroLogic, ``Nop) providing open tag subtyping without nominal declarations"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "OCaml Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'layout' composes functional data transformations across a 16-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
              "shortDescription": {
                "text": "OCaml Pattern: Closure Currying Strategy"
              },
              "fullDescription": {
                "text": "Function 'filter_builtins' accepts higher-order strategy parameter 'f' for dynamic algorithm injection"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-OCAML-UNCHECKED_EXCEPTION_RAISE",
              "name": "unchecked_exception_raise",
              "shortDescription": {
                "text": "OCaml Pattern: Unchecked Exception Raise"
              },
              "fullDescription": {
                "text": "Type Safety Audit: Function 'config' in 'Suite_cil_bytecode' throws unhandled runtime exception (`failwith`/`raise`); return typed `Result.t` or `Option.t` instead"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-DEFENSIVE_CATCH_ALL_EXN",
              "name": "defensive_catch_all_exn",
              "shortDescription": {
                "text": "OCaml Pattern: Defensive Catch All Exn"
              },
              "fullDescription": {
                "text": "Resilience Smell (Defensive Catch-All): Function 'obfuscated_c' in 'Suite_timing_check' swallows all exceptions (`with _ -> ...`); catch specific expected exceptions only"
              },
              "properties": {
                "category": "resilience"
              }
            },
            {
              "id": "DPX-OCAML-MUTABLE_REF_OVERUSE",
              "name": "mutable_ref_overuse",
              "shortDescription": {
                "text": "OCaml Pattern: Mutable Ref Overuse"
              },
              "fullDescription": {
                "text": "Functional Purity Audit: Module 'Vectis_cc' defines 60 mutable references / fields, breaking immutability; favor pure recursive accumulators"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-PHYSICAL_EQUALITY_SMELL",
              "name": "physical_equality_smell",
              "shortDescription": {
                "text": "OCaml Pattern: Physical Equality Smell"
              },
              "fullDescription": {
                "text": "Type Safety Hazard (Physical Equality): Function 'out1' in 'Suite_timing_check' uses physical pointer equality (`==` / `!=`); use structural value equality (`=` / `<>`) to avoid subtle value comparison bugs"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-GOD_MODULE_SRP",
              "name": "god_module_srp",
              "shortDescription": {
                "text": "OCaml Pattern: God Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Suite_chain_jit' defines 31 functions across 143 lines of code, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-CYCLOMATIC_COMPLEXITY_KISS",
              "name": "cyclomatic_complexity_kiss",
              "shortDescription": {
                "text": "OCaml Pattern: Cyclomatic Complexity Kiss"
              },
              "fullDescription": {
                "text": "KISS Violation (High Complexity): Function 'f_vor1' in 'C_visa_c_handlers' has cyclomatic complexity of 15; decompose nested pattern matches into helper functions"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "OCaml Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 59 location(s): Suite_timing_check.oc, Suite_encode_literals.oc, Suite_anti_disasm.oc"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
