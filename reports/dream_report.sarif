{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DPX-OCaml",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "DPX-OCAML-FUNCTOR_PARAMETRIC_MODULE",
              "name": "functor_parametric_module",
              "shortDescription": {
                "text": "OCaml Pattern: Functor Parametric Module"
              },
              "fullDescription": {
                "text": "Module 'Hello_world' implements Functor Parametric Module pattern enabling compile-time type parameterization and dependency injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-FIRST_CLASS_MODULE",
              "name": "first_class_module",
              "shortDescription": {
                "text": "OCaml Pattern: First Class Module"
              },
              "fullDescription": {
                "text": "Module 'Cipher' utilizes First-Class Modules for dynamic runtime dispatch and pluggable strategy injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-MODULE_INCLUSION_EXTENDER",
              "name": "module_inclusion_extender",
              "shortDescription": {
                "text": "OCaml Pattern: Module Inclusion Extender"
              },
              "fullDescription": {
                "text": "Module 'Dream' extends and composes functionality from 5 included module(s) (Dream__server.Log, Dream__server.Session, Method, Status, Formats)"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-POLYMORPHIC_VARIANTS",
              "name": "polymorphic_variants",
              "shortDescription": {
                "text": "OCaml Pattern: Polymorphic Variants"
              },
              "fullDescription": {
                "text": "Module 'Request' adopts Polymorphic Variants (``Quick, ``POST) providing open tag subtyping without nominal declarations"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-RAILWAY_MONADIC_BIND",
              "name": "railway_monadic_bind",
              "shortDescription": {
                "text": "OCaml Pattern: Railway Monadic Bind"
              },
              "fullDescription": {
                "text": "Function 'filename' implements Railway-oriented Monadic pipeline composing 2 sequential bind operation(s)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "OCaml Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'request' composes functional data transformations across a 4-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CPS_CONTINUATION_PASSING",
              "name": "cps_continuation_passing",
              "shortDescription": {
                "text": "OCaml Pattern: Cps Continuation Passing"
              },
              "fullDescription": {
                "text": "Function 'drain_payload' implements Continuation-Passing Style (CPS) ensuring stack-safe tail recursion via callback continuation"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
              "shortDescription": {
                "text": "OCaml Pattern: Closure Currying Strategy"
              },
              "fullDescription": {
                "text": "Function 'lock_sandbox' accepts higher-order strategy parameter 'f' for dynamic algorithm injection"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-OCAML-LAZY_MEMOIZATION",
              "name": "lazy_memoization",
              "shortDescription": {
                "text": "OCaml Pattern: Lazy Memoization"
              },
              "fullDescription": {
                "text": "Module 'Cipher' integrates Lazy Memoization pattern for deferred on-demand computation and caching"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-OCAML-RECORD_FUNCTION_VTABLE",
              "name": "record_function_vtable",
              "shortDescription": {
                "text": "OCaml Pattern: Record Function Vtable"
              },
              "fullDescription": {
                "text": "Record type 'reader' in 'Stream' implements explicit VTable Virtual Method Table containing 2 function method(s)"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-OCAML-ASYNC_LWT_PROMISES",
              "name": "async_lwt_promises",
              "shortDescription": {
                "text": "OCaml Pattern: Async Lwt Promises"
              },
              "fullDescription": {
                "text": "Module 'Error.eml' coordinates non-blocking asynchronous event I/O via cooperative promise concurrency (Lwt / Async)"
              },
              "properties": {
                "category": "effect_concurrency"
              }
            },
            {
              "id": "DPX-OCAML-UNCHECKED_EXCEPTION_RAISE",
              "name": "unchecked_exception_raise",
              "shortDescription": {
                "text": "OCaml Pattern: Unchecked Exception Raise"
              },
              "fullDescription": {
                "text": "Type Safety Audit: Function 'no_reader' in 'Stream' throws unhandled runtime exception (`failwith`/`raise`); return typed `Result.t` or `Option.t` instead"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-DEFENSIVE_CATCH_ALL_EXN",
              "name": "defensive_catch_all_exn",
              "shortDescription": {
                "text": "OCaml Pattern: Defensive Catch All Exn"
              },
              "fullDescription": {
                "text": "Resilience Smell (Defensive Catch-All): Function 'input_stream' in 'Tokens' swallows all exceptions (`with _ -> ...`); catch specific expected exceptions only"
              },
              "properties": {
                "category": "resilience"
              }
            },
            {
              "id": "DPX-OCAML-MUTABLE_REF_OVERUSE",
              "name": "mutable_ref_overuse",
              "shortDescription": {
                "text": "OCaml Pattern: Mutable Ref Overuse"
              },
              "fullDescription": {
                "text": "Functional Purity Audit: Module 'Stream' defines 23 mutable references / fields, breaking immutability; favor pure recursive accumulators"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-PHYSICAL_EQUALITY_SMELL",
              "name": "physical_equality_smell",
              "shortDescription": {
                "text": "OCaml Pattern: Physical Equality Smell"
              },
              "fullDescription": {
                "text": "Type Safety Hazard (Physical Equality): Function 'key' in 'Cipher' uses physical pointer equality (`==` / `!=`); use structural value equality (`=` / `<>`) to avoid subtle value comparison bugs"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-GOD_MODULE_SRP",
              "name": "god_module_srp",
              "shortDescription": {
                "text": "OCaml Pattern: God Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Stream' defines 42 functions across 473 lines of code, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "OCaml Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Test.expect.list, Test.list"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-CIRCULAR_MODULE_DEPENDENCY",
              "name": "circular_module_dependency",
              "shortDescription": {
                "text": "OCaml Pattern: Circular Module Dependency"
              },
              "fullDescription": {
                "text": "Circular Module Dependency detected: Csrf ➔ Log ➔ Dream ➔ Csrf"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
      },
