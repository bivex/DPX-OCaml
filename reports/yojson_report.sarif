{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DPX-OCaml",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "DPX-OCAML-FUNCTOR_PARAMETRIC_MODULE",
              "name": "functor_parametric_module",
              "shortDescription": {
                "text": "OCaml Pattern: Functor Parametric Module"
              },
              "fullDescription": {
                "text": "Module 'Read' implements Functor Parametric Module pattern enabling compile-time type parameterization and dependency injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-ABSTRACT_DATA_TYPE_INTERFACE",
              "name": "abstract_data_type_interface",
              "shortDescription": {
                "text": "OCaml Pattern: Abstract Data Type Interface"
              },
              "fullDescription": {
                "text": "Module 'Mucppo' encapsulates Abstract Data Type (ADT) via primary type `t` with constructor 'empty'"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-MODULE_INCLUSION_EXTENDER",
              "name": "module_inclusion_extender",
              "shortDescription": {
                "text": "OCaml Pattern: Module Inclusion Extender"
              },
              "fullDescription": {
                "text": "Module 'Yojson' extends and composes functionality from 2 included module(s) (Common, T)"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-POLYMORPHIC_VARIANTS",
              "name": "polymorphic_variants",
              "shortDescription": {
                "text": "OCaml Pattern: Polymorphic Variants"
              },
              "fullDescription": {
                "text": "Module 'Mocks' adopts Polymorphic Variants (``Int, ``Assoc) providing open tag subtyping without nominal declarations"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-RAILWAY_MONADIC_BIND",
              "name": "railway_monadic_bind",
              "shortDescription": {
                "text": "OCaml Pattern: Railway Monadic Bind"
              },
              "fullDescription": {
                "text": "Function 'pos' implements Railway-oriented Monadic pipeline composing 2 sequential bind operation(s)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "OCaml Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'extract_titles' composes functional data transformations across a 4-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
              "shortDescription": {
                "text": "OCaml Pattern: Closure Currying Strategy"
              },
              "fullDescription": {
                "text": "Function 'map_f' accepts higher-order strategy parameter 'f' for dynamic algorithm injection"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-OCAML-UNCHECKED_EXCEPTION_RAISE",
              "name": "unchecked_exception_raise",
              "shortDescription": {
                "text": "OCaml Pattern: Unchecked Exception Raise"
              },
              "fullDescription": {
                "text": "Type Safety Audit: Function 'sum_json' in 'Introduction' throws unhandled runtime exception (`failwith`/`raise`); return typed `Result.t` or `Option.t` instead"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-DEFENSIVE_CATCH_ALL_EXN",
              "name": "defensive_catch_all_exn",
              "shortDescription": {
                "text": "OCaml Pattern: Defensive Catch All Exn"
              },
              "fullDescription": {
                "text": "Resilience Smell (Defensive Catch-All): Function 'filter_index' in 'Util' swallows all exceptions (`with _ -> ...`); catch specific expected exceptions only"
              },
              "properties": {
                "category": "resilience"
              }
            },
            {
              "id": "DPX-OCAML-MUTABLE_REF_OVERUSE",
              "name": "mutable_ref_overuse",
              "shortDescription": {
                "text": "OCaml Pattern: Mutable Ref Overuse"
              },
              "fullDescription": {
                "text": "Functional Purity Audit: Module 'Ydump' defines 7 mutable references / fields, breaking immutability; favor pure recursive accumulators"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-PHYSICAL_EQUALITY_SMELL",
              "name": "physical_equality_smell",
              "shortDescription": {
                "text": "OCaml Pattern: Physical Equality Smell"
              },
              "fullDescription": {
                "text": "Type Safety Hazard (Physical Equality): Function 'finally' in 'Ydump' uses physical pointer equality (`==` / `!=`); use structural value equality (`=` / `<>`) to avoid subtle value comparison bugs"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-GOD_MODULE_SRP",
              "name": "god_module_srp",
              "shortDescription": {
                "text": "OCaml Pattern: God Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Util' defines 39 functions across 215 lines of code, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "OCaml Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Mucppo.start_conditional, State.start_conditional"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
      },
