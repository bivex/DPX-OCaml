          "rules": [
            {
              "id": "DPX-OCAML-FUNCTOR_PARAMETRIC_MODULE",
              "name": "functor_parametric_module",
              "shortDescription": {
                "text": "OCaml Pattern: Functor Parametric Module"
              },
              "fullDescription": {
                "text": "Module 'Bytebuffer' implements Functor Parametric Module pattern enabling compile-time type parameterization and dependency injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-ABSTRACT_DATA_TYPE_INTERFACE",
              "name": "abstract_data_type_interface",
              "shortDescription": {
                "text": "OCaml Pattern: Abstract Data Type Interface"
              },
              "fullDescription": {
                "text": "Module 'Bytebuffer_tests' encapsulates Abstract Data Type (ADT) via primary type `t` with constructor 'create'"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-FIRST_CLASS_MODULE",
              "name": "first_class_module",
              "shortDescription": {
                "text": "OCaml Pattern: First Class Module"
              },
              "fullDescription": {
                "text": "Module 'Cohttp_curl_lwt' utilizes First-Class Modules for dynamic runtime dispatch and pluggable strategy injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-MODULE_INCLUSION_EXTENDER",
              "name": "module_inclusion_extender",
              "shortDescription": {
                "text": "OCaml Pattern: Module Inclusion Extender"
              },
              "fullDescription": {
                "text": "Module 'Cohttp_lwt_jsoo' extends and composes functionality from 1 included module(s) (Cohttp_lwt.Private.String_io)"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-POLYMORPHIC_VARIANTS",
              "name": "polymorphic_variants",
              "shortDescription": {
                "text": "OCaml Pattern: Polymorphic Variants"
              },
              "fullDescription": {
                "text": "Module 'Cohttp_curl_lwt_tests' adopts Polymorphic Variants (``OK, ``GET) providing open tag subtyping without nominal declarations"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-RAILWAY_MONADIC_BIND",
              "name": "railway_monadic_bind",
              "shortDescription": {
                "text": "OCaml Pattern: Railway Monadic Bind"
              },
              "fullDescription": {
                "text": "Function 'resp' implements Railway-oriented Monadic pipeline composing 2 sequential bind operation(s)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "OCaml Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'root' composes functional data transformations across a 4-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
              "shortDescription": {
                "text": "OCaml Pattern: Closure Currying Strategy"
              },
              "fullDescription": {
                "text": "Function 'test_case' accepts higher-order strategy parameter 'f' for dynamic algorithm injection"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-OCAML-LAZY_MEMOIZATION",
              "name": "lazy_memoization",
              "shortDescription": {
                "text": "OCaml Pattern: Lazy Memoization"
              },
              "fullDescription": {
                "text": "Module 'Curl' integrates Lazy Memoization pattern for deferred on-demand computation and caching"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-OCAML-ASYNC_LWT_PROMISES",
              "name": "async_lwt_promises",
              "shortDescription": {
                "text": "OCaml Pattern: Async Lwt Promises"
              },
              "fullDescription": {
                "text": "Module 'Cohttp_curl_lwt_tests' coordinates non-blocking asynchronous event I/O via cooperative promise concurrency (Lwt / Async)"
              },
              "properties": {
                "category": "effect_concurrency"
              }
            },
            {
              "id": "DPX-OCAML-UNCHECKED_EXCEPTION_RAISE",
              "name": "unchecked_exception_raise",
              "shortDescription": {
                "text": "OCaml Pattern: Unchecked Exception Raise"
              },
              "fullDescription": {
                "text": "Type Safety Audit: Function 'check_error' in 'Cohttp_curl_lwt_tests' throws unhandled runtime exception (`failwith`/`raise`); return typed `Result.t` or `Option.t` instead"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-PHYSICAL_EQUALITY_SMELL",
              "name": "physical_equality_smell",
              "shortDescription": {
                "text": "OCaml Pattern: Physical Equality Smell"
              },
              "fullDescription": {
                "text": "Type Safety Hazard (Physical Equality): Function 'respText' in 'Cohttp_lwt_jsoo' uses physical pointer equality (`==` / `!=`); use structural value equality (`=` / `<>`) to avoid subtle value comparison bugs"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-GOD_MODULE_SRP",
              "name": "god_module_srp",
              "shortDescription": {
                "text": "OCaml Pattern: God Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Cohttp_lwt_jsoo' defines 42 functions across 357 lines of code, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "OCaml Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Cohttp_lwt_jsoo.src, Body_builder.src"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
      },
