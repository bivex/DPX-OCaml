      "tool": {
        "driver": {
          "name": "DPX-OCaml",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "DPX-OCAML-FUNCTOR_PARAMETRIC_MODULE",
              "name": "functor_parametric_module",
              "shortDescription": {
                "text": "OCaml Pattern: Functor Parametric Module"
              },
              "fullDescription": {
                "text": "Module 'Lwt_pqueue' implements Functor Parametric Module pattern enabling compile-time type parameterization and dependency injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-ABSTRACT_DATA_TYPE_INTERFACE",
              "name": "abstract_data_type_interface",
              "shortDescription": {
                "text": "OCaml Pattern: Abstract Data Type Interface"
              },
              "fullDescription": {
                "text": "Module 'Lwt_mvar' encapsulates Abstract Data Type (ADT) via primary type `t` with constructor 'create'"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-MODULE_INCLUSION_EXTENDER",
              "name": "module_inclusion_extender",
              "shortDescription": {
                "text": "OCaml Pattern: Module Inclusion Extender"
              },
              "fullDescription": {
                "text": "Module 'Lwt_result' extends and composes functionality from 1 included module(s) (Infix)"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-GADTS_EXPRESSION_EVAL",
              "name": "gadts_expression_eval",
              "shortDescription": {
                "text": "OCaml Pattern: Gadts Expression Eval"
              },
              "fullDescription": {
                "text": "Type 'mode' in 'Lwt_io' implements Generalized Algebraic Data Type (GADT) ensuring compile-time type-safe AST evaluation"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-POLYMORPHIC_VARIANTS",
              "name": "polymorphic_variants",
              "shortDescription": {
                "text": "OCaml Pattern: Polymorphic Variants"
              },
              "fullDescription": {
                "text": "Module 'Test_lwt_process' adopts Polymorphic Variants (``Dev_null, ``Dev_null) providing open tag subtyping without nominal declarations"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-RAILWAY_MONADIC_BIND",
              "name": "railway_monadic_bind",
              "shortDescription": {
                "text": "OCaml Pattern: Railway Monadic Bind"
              },
              "fullDescription": {
                "text": "Function 'infix_operator_tests' implements Railway-oriented Monadic pipeline composing 2 sequential bind operation(s)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "OCaml Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'state_query_tests' composes functional data transformations across a 3-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
              "shortDescription": {
                "text": "OCaml Pattern: Closure Currying Strategy"
              },
              "fullDescription": {
                "text": "Function 'test_iter' accepts higher-order strategy parameter 'f' for dynamic algorithm injection"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-OCAML-LAZY_MEMOIZATION",
              "name": "lazy_memoization",
              "shortDescription": {
                "text": "OCaml Pattern: Lazy Memoization"
              },
              "fullDescription": {
                "text": "Module 'Test_lwt_process' integrates Lazy Memoization pattern for deferred on-demand computation and caching"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-OCAML-EFFECT_HANDLERS",
              "name": "effect_handlers",
              "shortDescription": {
                "text": "OCaml Pattern: Effect Handlers"
              },
              "fullDescription": {
                "text": "Module 'Lwt_direct' adopts OCaml 5 Algebraic Effect Handlers for direct-style concurrency, state, and algebraic control flow"
              },
              "properties": {
                "category": "effect_concurrency"
              }
            },
            {
              "id": "DPX-OCAML-DOMAINS_PARALLELISM",
              "name": "domains_parallelism",
              "shortDescription": {
                "text": "OCaml Pattern: Domains Parallelism"
              },
              "fullDescription": {
                "text": "Module 'Selfdetector' leverages OCaml 5 Multicore Domains parallelism for shared-memory parallel thread execution"
              },
              "properties": {
                "category": "effect_concurrency"
              }
            },
            {
              "id": "DPX-OCAML-ASYNC_LWT_PROMISES",
              "name": "async_lwt_promises",
              "shortDescription": {
                "text": "OCaml Pattern: Async Lwt Promises"
              },
              "fullDescription": {
                "text": "Module 'Test' coordinates non-blocking asynchronous event I/O via cooperative promise concurrency (Lwt / Async)"
              },
              "properties": {
                "category": "effect_concurrency"
              }
            },
            {
              "id": "DPX-OCAML-UNCHECKED_EXCEPTION_RAISE",
              "name": "unchecked_exception_raise",
              "shortDescription": {
                "text": "OCaml Pattern: Unchecked Exception Raise"
              },
              "fullDescription": {
                "text": "Type Safety Audit: Function 'callback' in 'Test_lwt_list' throws unhandled runtime exception (`failwith`/`raise`); return typed `Result.t` or `Option.t` instead"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-DEFENSIVE_CATCH_ALL_EXN",
              "name": "defensive_catch_all_exn",
              "shortDescription": {
                "text": "OCaml Pattern: Defensive Catch All Exn"
              },
              "fullDescription": {
                "text": "Resilience Smell (Defensive Catch-All): Function 'f' in 'Test_lwt' swallows all exceptions (`with _ -> ...`); catch specific expected exceptions only"
              },
              "properties": {
                "category": "resilience"
              }
            },
            {
              "id": "DPX-OCAML-MUTABLE_REF_OVERUSE",
              "name": "mutable_ref_overuse",
              "shortDescription": {
                "text": "OCaml Pattern: Mutable Ref Overuse"
              },
              "fullDescription": {
                "text": "Functional Purity Audit: Module 'Test_lwt_list' defines 12 mutable references / fields, breaking immutability; favor pure recursive accumulators"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-PHYSICAL_EQUALITY_SMELL",
              "name": "physical_equality_smell",
              "shortDescription": {
                "text": "OCaml Pattern: Physical Equality Smell"
              },
              "fullDescription": {
                "text": "Type Safety Hazard (Physical Equality): Function 'step' in 'Test_lwt' uses physical pointer equality (`==` / `!=`); use structural value equality (`=` / `<>`) to avoid subtle value comparison bugs"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-GOD_MODULE_SRP",
              "name": "god_module_srp",
              "shortDescription": {
                "text": "OCaml Pattern: God Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Test_lwt_list' defines 42 functions across 678 lines of code, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "OCaml Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Test_lwt_switch.hook, Test_lwt_switch.successful_hook"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
