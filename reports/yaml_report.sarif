          "rules": [
            {
              "id": "DPX-OCAML-FUNCTOR_PARAMETRIC_MODULE",
              "name": "functor_parametric_module",
              "shortDescription": {
                "text": "OCaml Pattern: Functor Parametric Module"
              },
              "fullDescription": {
                "text": "Module 'M' implements Functor Parametric Module pattern enabling compile-time type parameterization and dependency injection"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-MODULE_INCLUSION_EXTENDER",
              "name": "module_inclusion_extender",
              "shortDescription": {
                "text": "OCaml Pattern: Module Inclusion Extender"
              },
              "fullDescription": {
                "text": "Module 'M' extends and composes functionality from 1 included module(s) (Yaml_bindings.M)"
              },
              "properties": {
                "category": "module_system"
              }
            },
            {
              "id": "DPX-OCAML-POLYMORPHIC_VARIANTS",
              "name": "polymorphic_variants",
              "shortDescription": {
                "text": "OCaml Pattern: Polymorphic Variants"
              },
              "fullDescription": {
                "text": "Module 'Yaml_bindings_types' adopts Polymorphic Variants (``Any, ``E) providing open tag subtyping without nominal declarations"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-RAILWAY_MONADIC_BIND",
              "name": "railway_monadic_bind",
              "shortDescription": {
                "text": "OCaml Pattern: Railway Monadic Bind"
              },
              "fullDescription": {
                "text": "Function 'v' implements Railway-oriented Monadic pipeline composing 20 sequential bind operation(s)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "OCaml Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'v' composes functional data transformations across a 4-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
              "shortDescription": {
                "text": "OCaml Pattern: Closure Currying Strategy"
              },
              "fullDescription": {
                "text": "Function 'check_file' accepts higher-order strategy parameter 'f' for dynamic algorithm injection"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-OCAML-UNCHECKED_EXCEPTION_RAISE",
              "name": "unchecked_exception_raise",
              "shortDescription": {
                "text": "OCaml Pattern: Unchecked Exception Raise"
              },
              "fullDescription": {
                "text": "Type Safety Audit: Function 'of_file_exn' in 'Yaml_unix' throws unhandled runtime exception (`failwith`/`raise`); return typed `Result.t` or `Option.t` instead"
              },
              "properties": {
                "category": "type_safety"
              }
            },
            {
              "id": "DPX-OCAML-DEFENSIVE_CATCH_ALL_EXN",
              "name": "defensive_catch_all_exn",
              "shortDescription": {
                "text": "OCaml Pattern: Defensive Catch All Exn"
              },
              "fullDescription": {
                "text": "Resilience Smell (Defensive Catch-All): Function 'cflags' in 'Discover' swallows all exceptions (`with _ -> ...`); catch specific expected exceptions only"
              },
              "properties": {
                "category": "resilience"
              }
            },
            {
              "id": "DPX-OCAML-GOD_MODULE_SRP",
              "name": "god_module_srp",
              "shortDescription": {
                "text": "OCaml Pattern: God Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Yaml_bindings_types' defines 46 functions across 424 lines of code, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-OCAML-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "OCaml Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Yaml_bindings_types.enum, M.enum"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
